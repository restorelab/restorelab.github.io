{
  "name": "restorelab.github.io",
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "sync": "node scripts/sync-docs.mjs",
    "sync:check": "node scripts/sync-docs.mjs --check",
    "gen:cli": "node scripts/gen-cli.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "test": "node --test --experimental-strip-types scripts/lib/*.test.mjs",
    "lint:api": "redocly lint spec/openapi.yaml",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:api": "node scripts/check-api-drift.mjs",
    "check:version": "node scripts/check-version.mjs",
    "check": "node scripts/check-all.mjs",
    "copy:spec": "node scripts/copy-spec.mjs",
    "prebuild": "npm run copy:spec && npm run lint:api"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.42.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.2.10",
    "sharp": "^0.35.3",
    "starlight-openapi": "^0.26.1",
    "tailwindcss": "^4.3.3",
    "yaml": "^2.9.0"
  },
  "allowScripts": {
    "esbuild": true
  },
  "private": true,
  "devDependencies": {
    "@redocly/cli": "^2.51.0",
    "playwright": "^1.62.1"
  }
}
