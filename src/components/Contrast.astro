---
import type { Lang, LandingCopy } from '../i18n/landing';

/**
 * L'argument : ce que la vérification de sauvegarde affirme, face à ce qu'un
 * exercice prouve. Les deux colonnes viennent du README.
 *
 * La zone vide hachurée sous la première colonne est l'argument lui-même : ce
 * que la vérification ne dit pas.
 */
interface Props {
  copy: LandingCopy;
  lang: Lang;
}

const { copy } = Astro.props;
const { contrast } = copy;
---

<section class="section" id="why">
  <div class="wrap section__grid">
    <div class="section__aside">
      <span class="section__index">01</span>
      <span class="section__label">{contrast.label}</span>
    </div>

    <div>
      <h2 class="section__title">{contrast.title}</h2>
      <p class="prose">{contrast.intro}</p>

      <div class="contrast" style="margin-top: 1.75rem;">
        <div class="card">
          <h3 class="card__title">{contrast.verificationTitle}</h3>
          <ul class="checks">
            {
              contrast.verification.map((item) => (
                <li>
                  <span class="mark" aria-hidden="true">
                    ✓
                  </span>
                  <span>{item}</span>
                </li>
              ))
            }
          </ul>
          <div class="card__void" aria-hidden="true"></div>
        </div>

        <div class="card card--claim">
          <h3 class="card__title">{contrast.claimTitle}</h3>
          <ul class="checks checks--proof">
            {
              contrast.claim.map((item) => (
                <li>
                  <span class="mark" aria-hidden="true">
                    ✓
                  </span>
                  <span>{item}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>

      <p class="pullquote">{contrast.pullquote}</p>

      <p class="prose" style="margin-top: 1.5rem;">{contrast.outro}</p>
    </div>
  </div>
</section>
