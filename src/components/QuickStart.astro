---
import { Code } from 'astro:components';
import type { Lang, LandingCopy } from '../i18n/landing';
import { localize } from '../i18n/landing';
import { RESTORELAB_VERSION } from '../version.ts';

/**
 * L'installation, tirée du README : lancer, puis finir dans le navigateur.
 * Shiki colore au build à travers `astro:components`, donc rien n'est hydraté ;
 * les boutons de copie sont une douzaine de lignes de JavaScript inline, sans
 * aucune dépendance.
 *
 * Les commandes et le bloc de sortie de `serve` ne sont pas dans le
 * dictionnaire de copie : les commandes sont identiques dans les deux langues,
 * et la sortie est celle du binaire, qui n'affiche que de l'anglais.
 */
interface Props {
  copy: LandingCopy;
  lang: Lang;
}

const { copy, lang } = Astro.props;
const { quickStart, copyButton } = copy;

const shiki = {
  themes: { light: 'github-light', dark: 'github-dark' },
  defaultColor: false as const,
};

/**
 * Les commandes des deux étapes ; le texte qui les accompagne est traduit.
 *
 * Le conteneur d'abord, l'archive ensuite : RestoreLab s'installe sur de
 * l'infrastructure, donc ce qu'on propose en premier doit être une image ou un
 * fichier, pas une chaîne de compilation. Compiler depuis les sources demande
 * maintenant Go *et* Node, le tableau de bord étant embarqué — c'est le
 * troisième chemin, et il est dans une note.
 *
 * Le numéro de version vient de `src/version.ts` : l'URL `releases/latest` de
 * GitHub exige le nom de fichier exact, donc la version se retrouve dans une
 * commande, et un numéro recopié vieillit.
 */
const commands = [
  `docker run -p 8080:8080 -v restorelab:/home/restorelab/.restorelab \\
  ghcr.io/restorelab/restorelab serve --listen 0.0.0.0:8080`,
  `curl -fsSL -O https://github.com/restorelab/restorelab/releases/latest/download/restorelab_${RESTORELAB_VERSION}_linux_amd64.tar.gz
tar xzf restorelab_${RESTORELAB_VERSION}_linux_amd64.tar.gz
./restorelab serve`,
];

const steps = commands.map((code, i) => ({
  n: String(i + 1).padStart(2, '0'),
  text: quickStart.steps[i],
  code,
}));

/** Les libellés que le script inline pose sur le bouton après un clic. */
const copyLabels = {
  'data-label-copy': copyButton.label,
  'data-label-copied': copyButton.copied,
  'data-label-failed': copyButton.failed,
};
---

<section class="section" id="quick-start">
  <div class="wrap section__grid">
    <div class="section__aside">
      <span class="section__index">04</span>
      <span class="section__label">{quickStart.label}</span>
    </div>

    <div>
      <h2 class="section__title">{quickStart.title}</h2>
      <p class="prose">{quickStart.intro}</p>

      {
        quickStart.notice && (
          <div class="caveat" style="margin-top: 1.5rem;">
            <p set:html={quickStart.notice} />
          </div>
        )
      }

      <div class="steps">
        {
          steps.map((step) => (
            <div class="step">
              <div class="step__head">
                <span class="step__n">{step.n}</span>
                <p class="step__text">{step.text}</p>
              </div>
              <div class="codeblock">
                <Code code={step.code} lang="bash" wrap {...shiki} />
                <button
                  class="copy"
                  type="button"
                  data-copy={step.code}
                  aria-label={`${copyButton.ariaPrefix} ${step.code}`}
                  {...copyLabels}
                >
                  {copyButton.label}
                </button>
              </div>
            </div>
          ))
        }
      </div>

      <p class="prose" style="margin-top: 2rem;" set:html={quickStart.setupIntro} />

      <div class="term" style="margin-top: 0.9rem;">
        <div class="term__bar">
          <span class="term__prompt">$</span>
          <span>bin/restorelab serve</span>
        </div>
        <pre
          class="term__body"><span class="term__warn">!</span> RestoreLab is not configured yet.
  Open this address to set it up. The token is printed once, and used once:

      <span class="term__rto">http://127.0.0.1:8080/setup?token=rls_...</span></pre>
      </div>

      <p class="prose" style="margin-top: 1.5rem;">{quickStart.setupBody}</p>
      <p class="prose">{quickStart.setupBody2}</p>

      <div class="subhead">
        <h3 class="subhead__title">{quickStart.subheadTitle}</h3>
        <p class="prose">{quickStart.subheadBody}</p>
      </div>

      <div class="codeblock">
        <Code code={quickStart.terminal} lang="bash" {...shiki} />
        <button
          class="copy"
          type="button"
          data-copy={quickStart.terminal}
          aria-label={quickStart.terminalAria}
          {...copyLabels}
        >
          {copyButton.label}
        </button>
      </div>

      <div class="notes">
        {
          quickStart.notes.map((note) => (
            <div class="note">
              <h3 class="note__title">{note.title}</h3>
              <p set:html={note.body} />
            </div>
          ))
        }
      </div>

      <p class="linkrow">
        <a href={localize('/start/quick-start/', lang)}>{quickStart.moreLink}</a>
      </p>
    </div>
  </div>
</section>

<script is:inline>
  // Les libellés viennent de `data-label-*` : ce script n'est pas transformé,
  // il ne peut donc pas interpoler une variable Astro, et la landing existe en
  // deux langues.
  document.addEventListener('click', function (event) {
    var button = event.target.closest('.copy');
    if (!button || !navigator.clipboard) return;
    var idle = button.dataset.labelCopy || 'Copy';
    navigator.clipboard.writeText(button.getAttribute('data-copy')).then(
      function () {
        button.dataset.copied = 'true';
        button.textContent = button.dataset.labelCopied || 'Copied';
        setTimeout(function () {
          button.dataset.copied = 'false';
          button.textContent = idle;
        }, 1600);
      },
      function () {
        button.textContent = button.dataset.labelFailed || 'Failed';
        setTimeout(function () {
          button.textContent = idle;
        }, 1600);
      },
    );
  });
</script>
