---
/**
 * Closing call to action, then the four links a visitor may still want:
 * documentation, repository, licence, security policy.
 */
const repo = 'https://github.com/restorelab/restorelab';
---

<footer class="footer">
  <div class="wrap cta">
    <h2 class="cta__title">
      Run one drill, and stop estimating your recovery time.
    </h2>
    <div class="hero__actions">
      <a class="btn btn--primary" href="/start/quick-start/">Quick start</a>
      <a class="btn btn--ghost" href={repo}>View on GitHub</a>
    </div>
  </div>

  <div class="wrap">
    <div class="footer__cols">
      <div class="footer__col">
        <h2>Documentation</h2>
        <ul>
          <li><a href="/start/introduction/">Introduction</a></li>
          <li><a href="/start/quick-start/">Quick start</a></li>
          <li><a href="/guides/recovery-plans/">Recovery plans</a></li>
          <li><a href="/reference/http-api/">HTTP API</a></li>
          <li><a href="/api/">API reference</a></li>
        </ul>
      </div>

      <div class="footer__col">
        <h2>Project</h2>
        <ul>
          <li><a href={repo}>Repository</a></li>
          <li><a href={`${repo}/blob/master/SECURITY.md`}>Security policy</a></li>
          <li>
            <a href={`${repo}/blob/master/CONTRIBUTING.md`}>Contributing</a>
          </li>
          <li><a href={`${repo}/blob/master/LICENSE`}>Licence, AGPL-3.0</a></li>
        </ul>
      </div>

      <div class="footer__col">
        <h2>Licence</h2>
        <p class="prose" style="font-size: 0.9rem;">
          RestoreLab is free to self-host, modify and run. If you offer it as a
          network service, the same freedoms must reach your users.
        </p>
      </div>
    </div>

    <div class="footer__base">
      <span>RestoreLab — AGPL-3.0</span>
      <span>Automated recovery drills for Proxmox VE</span>
    </div>
  </div>
</footer>
