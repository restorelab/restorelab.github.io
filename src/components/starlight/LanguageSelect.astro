---
import Default from '@astrojs/starlight/components/LanguageSelect.astro';

/**
 * Le sélecteur de langue de Starlight, masqué sur la référence d'API.
 *
 * `starlight-openapi` n'a aucun support i18n : il ne rend qu'un seul jeu de
 * routes, en anglais, sous `/api/`. Le sélecteur de Starlight, lui, est
 * générique — il calcule la page équivalente par simple préfixage et propose
 * donc `/fr/api/...`, une URL qui n'existe pas. Sans ce garde-fou, les 30 pages
 * de la référence d'API offrent un lien mort.
 *
 * Une redirection aurait été préférable, mais Astro refuse une redirection
 * dynamique dont la destination n'est pas elle-même une route paramétrée, et
 * les routes de `starlight-openapi` n'en sont pas. On n'affiche donc pas de
 * sélecteur là où il n'y a effectivement qu'une langue.
 *
 * À retirer si `starlight-openapi` gagne l'i18n, ou si la référence vient à
 * être générée une seconde fois sous `/fr/api/`.
 */
const isApiReference = Astro.url.pathname.startsWith('/api/');
---

{!isApiReference && <Default />}
