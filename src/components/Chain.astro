---
import type { Lang, LandingCopy } from '../i18n/landing';

/**
 * La chaîne qu'un exercice parcourt, tirée du README. Rendue en jetons qui
 * passent à la ligne plutôt qu'en bloc de texte recopié, pour rester lisible
 * jusqu'au téléphone.
 */
interface Props {
  copy: LandingCopy;
  lang: Lang;
}

const { copy } = Astro.props;
const { chain } = copy;
---

<section class="section" id="chain">
  <div class="wrap section__grid">
    <div class="section__aside">
      <span class="section__index">02</span>
      <span class="section__label">{chain.label}</span>
    </div>

    <div>
      <h2 class="section__title">{chain.title}</h2>
      <p class="prose" style="margin-bottom: 1.75rem;">{chain.intro}</p>

      <ol class="chain">
        {
          chain.steps.map((step, i) => (
            <li>
              <span
                class={`chain__step${i === chain.steps.length - 1 ? ' is-last' : ''}`}
              >
                {step}
              </span>
              {i < chain.steps.length - 1 && (
                <span class="chain__arrow" aria-hidden="true">
                  →
                </span>
              )}
            </li>
          ))
        }
      </ol>

      <div class="notes">
        {
          chain.notes.map((note) => (
            <div class="note">
              <h3 class="note__title">{note.title}</h3>
              <p set:html={note.body} />
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
