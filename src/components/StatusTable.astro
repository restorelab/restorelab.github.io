---
import type { Lang, LandingCopy, StatusRowId } from '../i18n/landing';
import { localize } from '../i18n/landing';

/**
 * La table de capacités du README, non abrégée. Les deux réserves honnêtes —
 * Proxmox Backup Server et les contrôles réseau n'ont jamais tourné contre du
 * vrai matériel — sont énoncées au-dessus de la table et répétées sur les
 * lignes concernées. Ce ne sont pas des notes de bas de page.
 *
 * L'ordre et l'état vivent ici, pas dans le dictionnaire : ce sont des données,
 * et les dupliquer par langue les laisserait diverger. Seul le libellé est
 * traduit, désigné par un identifiant que `Record<StatusRowId, string>` force
 * chaque langue à couvrir.
 */
interface Props {
  copy: LandingCopy;
  lang: Lang;
}

const { copy, lang } = Astro.props;
const { status } = copy;

type State = 'done' | 'next' | 'planned';

const rows: { id: StatusRowId; state: State }[] = [
  { id: 'proxmoxProvider', state: 'done' },
  { id: 'pbsDiscovery', state: 'done' },
  { id: 'recoveryEngine', state: 'done' },
  { id: 'networkChecks', state: 'done' },
  { id: 'guestAgentChecks', state: 'done' },
  { id: 'cli', state: 'done' },
  { id: 'reports', state: 'done' },
  { id: 'oneCommandSetup', state: 'done' },
  { id: 'doctorAndNetwork', state: 'done' },
  { id: 'drillHistory', state: 'done' },
  { id: 'httpApi', state: 'done' },
  { id: 'confidenceScore', state: 'done' },
  { id: 'triggerOverHttp', state: 'done' },
  { id: 'storedPlans', state: 'done' },
  { id: 'sessionCookie', state: 'done' },
  { id: 'dashboard', state: 'done' },
  { id: 'launchFromBrowser', state: 'done' },
  { id: 'planCatalogueInBrowser', state: 'done' },
  { id: 'setupInBrowser', state: 'done' },
  { id: 'scheduledDrills', state: 'next' },
  { id: 'remoteProbes', state: 'planned' },
];

const legendOrder: State[] = ['done', 'next', 'planned'];

/** Le lien du guide d'isolation réseau, dans la phrase de l'encadré. */
const caveat = status.caveat.replace(
  '{networkIsolation}',
  localize('/guides/network-isolation/', lang),
);
---

<section class="section" id="status">
  <div class="wrap section__grid">
    <div class="section__aside">
      <span class="section__index">06</span>
      <span class="section__label">{status.label}</span>
    </div>

    <div>
      <h2 class="section__title">{status.title}</h2>
      <p class="prose" style="margin-bottom: 1.75rem;">{status.intro}</p>

      <div class="caveat">
        <p set:html={caveat} />
      </div>

      <div class="matrix">
        {
          rows.map((row) => (
            <div class="matrix__row">
              <div class="matrix__area">
                <span set:html={status.areas[row.id]} />
                {status.caveats[row.id] && (
                  <span class="matrix__caveat">{status.caveats[row.id]}</span>
                )}
              </div>
              <span class={`pill pill--${row.state}`}>
                {status.states[row.state]}
              </span>
            </div>
          ))
        }
      </div>

      <p class="legend">
        {
          legendOrder.map((state) => (
            <span>
              <span class={`pill pill--${state}`}>{status.states[state]}</span>
              {' '}
              {status.legend[state]}
            </span>
          ))
        }
      </p>
    </div>
  </div>
</section>
