---
import { Code } from 'astro:components';
import type { Lang, LandingCopy } from '../i18n/landing';
import { localize } from '../i18n/landing';

/**
 * Un plan de restauration, verbatim depuis le README. Coloré au build par
 * Shiki à travers `astro:components` — aucun coloriseur côté client.
 *
 * Le document YAML n'est pas dans le dictionnaire de copie, commentaire
 * compris : il reproduit `examples/plans/postgres-prod.yaml`, un vrai fichier
 * du dépôt produit. Le traduire donnerait un fichier qui n'existe pas.
 */
interface Props {
  copy: LandingCopy;
  lang: Lang;
}

const { copy, lang } = Astro.props;
const { plan: planCopy, copyButton } = copy;

const shiki = {
  themes: { light: 'github-light', dark: 'github-dark' },
  defaultColor: false as const,
};

const run = 'restorelab recovery run examples/plans/postgres-prod.yaml';

const plan = `name: postgres-prod

workload:
  provider: proxmox-main
  id: "101"

backup:
  strategy: latest
  max_age: 26h

restore:
  node: pve02
  network: isolated
  cpu_limit: 2
  memory_limit: 4096

startup:
  timeout: 180s

checks:
  # Runs inside the guest through the QEMU guest agent: no route into the
  # isolated recovery network required.
  - type: command
    run: systemctl is-active postgresql
    expect: active

  - type: tcp
    port: 22

  - type: http
    url: http://{{ .ip }}:8080/health
    expected_status: 200

cleanup:
  always: true

rto_target: 5m
`;
---

<section class="section" id="plans">
  <div class="wrap section__grid">
    <div class="section__aside">
      <span class="section__index">05</span>
      <span class="section__label">{planCopy.label}</span>
    </div>

    <div>
      <h2 class="section__title">{planCopy.title}</h2>
      <p class="prose">{planCopy.intro}</p>

      <div class="plan">
        <div class="codeblock">
          <Code code={plan} lang="yaml" {...shiki} />
        </div>

        <div class="codeblock">
          <Code code={run} lang="bash" wrap {...shiki} />
          <button
            class="copy"
            type="button"
            data-copy={run}
            aria-label={`${copyButton.ariaPrefix} ${run}`}
            data-label-copy={copyButton.label}
            data-label-copied={copyButton.copied}
            data-label-failed={copyButton.failed}
          >
            {copyButton.label}
          </button>
        </div>
      </div>

      <p class="linkrow">
        <a href={localize('/guides/recovery-plans/', lang)}>
          {planCopy.moreLink}
        </a>
      </p>
    </div>
  </div>
</section>
