---
import type { Lang, LandingCopy, ShotId } from '../i18n/landing';

/**
 * Captures du tableau de bord, prises par `scripts/screenshots.mjs` contre une
 * base de démonstration. Les variantes claire et sombre sont servies par
 * `prefers-color-scheme` seul ; il n'y a aucun JavaScript sur cette page en
 * dehors des boutons de copie.
 *
 * Les sources sont en 2880x1800 (une fenêtre 1440x900 à deviceScaleFactor 2),
 * et la taille intrinsèque est déclarée pour que la mise en page ne saute
 * jamais au chargement.
 */
interface Props {
  copy: LandingCopy;
  lang: Lang;
}

const { copy } = Astro.props;
const { screens } = copy;

/** Les trois vignettes, dans l'ordre. Le nom est celui du fichier image. */
const thumbs: ShotId[] = ['history', 'workloads', 'diagnostics'];
---

<section class="section" id="dashboard">
  <div class="wrap section__grid">
    <div class="section__aside">
      <span class="section__index">03</span>
      <span class="section__label">{screens.label}</span>
    </div>

    <div>
      <h2 class="section__title">{screens.title}</h2>
      <p class="prose">{screens.intro}</p>
      <p class="prose">{screens.intro2}</p>
    </div>
  </div>

  <div class="wrap">
    <figure class="shot shot--hero">
      <picture>
        <source
          srcset="/img/dashboard/overview-dark.png"
          media="(prefers-color-scheme: dark)"
        />
        <img
          src="/img/dashboard/overview-light.png"
          alt={screens.shots.overview.alt}
          width="2880"
          height="1800"
        />
      </picture>
      <figcaption class="shot__caption">
        <span class="shot__name">{screens.shots.overview.caption}</span>
        <span class="shot__note">{screens.shots.overview.note}</span>
      </figcaption>
    </figure>

    <figure class="shot shot--hero">
      <picture>
        <source
          srcset="/img/dashboard/drill-dark.png"
          media="(prefers-color-scheme: dark)"
        />
        <img
          src="/img/dashboard/drill-light.png"
          alt={screens.shots.drill.alt}
          width="2880"
          height="1800"
          loading="lazy"
          decoding="async"
        />
      </picture>
      <figcaption class="shot__caption">
        <span class="shot__name">{screens.shots.drill.caption}</span>
        <span class="shot__note">{screens.shots.drill.note}</span>
      </figcaption>
    </figure>

    <div class="thumbs">
      {
        thumbs.map((id) => (
          <figure class="shot">
            <picture>
              <source
                srcset={`/img/dashboard/${id}-dark.png`}
                media="(prefers-color-scheme: dark)"
              />
              <img
                src={`/img/dashboard/${id}-light.png`}
                alt={screens.shots[id].alt}
                width="2880"
                height="1800"
                loading="lazy"
                decoding="async"
              />
            </picture>
            <figcaption class="shot__caption">
              <span class="shot__name">{screens.shots[id].caption}</span>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>
